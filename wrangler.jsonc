{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www-ijlanga-co-za",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "SUPABASE_URL": "https://pyhcmceyhrulkwzedwgf.supabase.co"
  }
}
